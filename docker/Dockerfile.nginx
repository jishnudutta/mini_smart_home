# Smart Room dashboard + standalone nginx gateway.
# Stage 1: build the React dashboard.
# Stage 2: nginx serves the static build and proxies /api + /ws to the
#          backend container — nginx stays its own image, so it can be
#          swapped or tuned without touching the app.
#
# Build (from repo root):  docker build -f docker/Dockerfile.nginx -t smartroom-nginx .
#
# VITE_API_URL defaults to "" (same-origin): the browser talks to nginx on
# the published port, and nginx forwards to the backend. Override only if you
# serve the API from a different origin.
FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
