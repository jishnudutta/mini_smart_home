# Frontend build-time configuration (Vite).
# Copy to .env.local for local development — never commit real values.

# Where the dashboard talks to the backend API.
#   Empty (default)  → same-origin. In the Docker stack nginx serves the
#                      dashboard AND proxies /api + /ws to the backend, so
#                      the browser never needs to know where the API lives.
#   Development      → point at the backend, e.g. http://127.0.0.1:8000
VITE_API_URL=
