# Copy to .env (or export) as needed. Every value has a sane default.

# DATABASE_URL=sqlite:///./smartroom.db
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000

# NODE_ID=esp32_room_01
# NODE_TIMEOUT_SECONDS=15

# Simulator (virtual node) — OFF by default; enable for development only
# SIMULATOR_ENABLED=false
# SIM_REPORT_INTERVAL=5
# SIM_READING_INTERVAL=30
# SIM_TEMP_BASE=27.6
# SIM_TEMP_AMPLITUDE=0.8
# SIM_TEMP_PERIOD=420

# Automation
# AUTOMATION_INTERVAL=2
# SMART_FAN_ON_TEMP=28
# SMART_FAN_OFF_TEMP=27
